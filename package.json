{
  "name": "opencode-extended-sidebar",
  "version": "0.2.18",
  "description": "OpenCode TUI sidebar: session switcher, live tools/files, click-for-detail dialogs with scrollable file preview, perf timing logs, height-aware row trimming, a My work queue (open questions + plan approvals) and an optional OMO group with works, boulder and a document index (read-only)",
  "type": "module",
  "license": "MIT",
  "author": "pleware",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pleware/opencode-extended-sidebar.git"
  },
  "homepage": "https://github.com/pleware/opencode-extended-sidebar#readme",
  "bugs": {
    "url": "https://github.com/pleware/opencode-extended-sidebar/issues"
  },
  "keywords": [
    "opencode",
    "plugin",
    "tui",
    "sidebar",
    "session-switcher",
    "token-usage",
    "latency",
    "observability",
    "oh-my-openagent",
    "boulder",
    "markdown-preview",
    "my-work",
    "phrouros"
  ],
  "oc-plugin": [
    "tui"
  ],
  "exports": {
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "oes.json",
    ".oesignore",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.3.7",
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.9",
    "@opentui/solid": "^0.5.9",
    "@types/bun": "^1.4.0",
    "solid-js": "^1.9.15"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "test": "bun test test/unit test/snapshot",
    "typecheck": "tsc --noEmit",
    "bench": "bun test test/bench"
  },
  "dependencies": {
    "ignore": "^7.0.7"
  }
}
